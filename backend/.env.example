# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medikiosk?retryWrites=true&w=majority

# Qwen LLM (OpenAI-Compatible API)
QWEN_API_KEY=your_qwen_or_openai_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Sarvam AI (Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v1

# Security & JWT Auth
JWT_SECRET=super_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# CORS Frontend Client URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=30
